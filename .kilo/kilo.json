{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "context/project.md"
  ],
  "permission": {
    "edit": {
      "apps/web/src/**": "allow",
      "apps/api/src/**": "allow",
      "*.md": "allow",
      "*": "ask"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "ask"
  },
  "snapshot": true,
  "compaction": {
    "auto": true,
    "prune": true
  }
}
